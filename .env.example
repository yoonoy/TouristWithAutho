DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail for account confirmation and password reset codes (SMTP).
# Leave SMTP_HOST empty while developing: the 6-digit codes are then printed in the server console.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character Google "App password">, MAIL_FROM="Travel Horizon <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Set to true only when the server runs behind a trusted proxy (uses X-Forwarded-For for rate limits).
TRUST_PROXY=false
